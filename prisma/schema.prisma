generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  currentHeroId String?   @unique
  maxHeroes     Int?      @default(3)
  accounts      Account[]
  heroes        Hero[]
  sessions      Session[]
  currentHero   Hero?     @relation("CurrentHero", fields: [currentHeroId], references: [id])

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Class {
  id              Int            @id @default(autoincrement())
  name            String         @unique
  slug            String         @unique
  icon            String
  tier            Int            @default(1)
  role            ClassRole
  position        CombatPosition
  difficulty      Difficulty
  description     String
  lore            String?
  baseAttrs       Json
  primaryAttr     String
  secondaryAttr   String
  unlockCondition Json?
  createdAt       DateTime       @default(now())
  heroes          Hero[]
  skills          Skill[]

  @@map("classes")
}

model Race {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  slug           String   @unique
  icon           String
  flavor         String
  lore           String
  attrMods       Json
  racialTraits   Json
  bestForClasses Int[]
  createdAt      DateTime @default(now())
  heroes         Hero[]

  @@map("races")
}

model Skill {
  id              Int         @id @default(autoincrement())
  classId         Int?
  name            String
  slug            String
  icon            String
  type            SkillType
  tier            Int         @default(1)
  timing          SkillTiming @default(round)
  description     String
  effect          String
  epCost          Int         @default(0)
  goldCost        Int         @default(0)
  manaCost        Int         @default(0)
  multiplier      Float       @default(1.0)
  cooldownRounds  Int         @default(0)
  requiresSkills  Int[]       @default([])
  formula         Json?
  tags            String[]    @default([])
  createdAt       DateTime    @default(now())
  attackCategory  String?
  defenseCategory String?
  maxRank         Int         @default(10)
  heroSkills      HeroSkill[]
  class           Class?      @relation(fields: [classId], references: [id])
  raceReq         Int[]       @default([])

  @@unique([classId, slug])
  @@map("skills")
}

model Dungeon {
  id               Int          @id @default(autoincrement())
  name             String
  slug             String       @unique
  icon             String
  region           String
  description      String
  lore             String
  levelReq         Int          @default(1)
  recommendedLevel Int          @default(1)
  difficulty       Int
  difficultyLabel  String
  scheduledTimes   Json         @default("[\"02:00\", \"06:00\", \"10:00\", \"14:00\", \"18:00\", \"22:00\"]")
  isInstant        Boolean      @default(false)
  epReward         Int
  goldReward       Int
  fameReward       Int          @default(5)
  levels           Json
  lootTable        Json
  isEventOnly      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  clanId           String?      @unique
  runs             DungeonRun[]
  clan             Clan?        @relation(fields: [clanId], references: [id])

  @@map("dungeons")
}

model Enemy {
  id           Int            @id @default(autoincrement())
  name         String
  icon         String
  hp           Int
  mp           Int            @default(0)
  atk          Int
  def          Int
  dx           Int            @default(10)
  ag           Int            @default(10)
  level        Int
  baseLevel    Int?
  growthFactor Float?
  position     CombatPosition
  lootTable    Json?
  conditions   Json?
  ai           Json           @default("{\"type\": \"weakest\"}")
  createdAt    DateTime       @default(now())
  damageType   String?
  skillIds     Int[]          @default([])
  faction      String?

  @@map("enemies")
}

model Item {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  icon          String
  category      ItemCategory
  rarity        ItemRarity
  description   String
  stats         Json
  classReq      Int[]
  raceReq       Int[]          @default([])
  levelReq      Int            @default(1)
  attrReq       Json?
  skillReq      Int[]          @default([])
  runeSlots     Int            @default(0)
  price         Int?
  isCraftable   Boolean        @default(false)
  recipe        Json?
  createdAt     DateTime       @default(now())
  slot          EquipmentSlot?
  twoHanded     Boolean        @default(false)
  bazarListings BazarListing[]
  heroItems     HeroItem[]

  @@map("items")
}

model Material {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  icon          String
  rarity        ItemRarity
  description   String
  dropSources   String[]
  createdAt     DateTime       @default(now())
  heroMaterials HeroMaterial[]

  @@map("materials")
}

model Hero {
  id                       String                  @id @default(uuid())
  userId                   String
  name                     String
  description              String          @default("")
  classId                  Int
  raceId                   Int
  level                    Int                     @default(1)
  epTotal                  Int                     @default(0)
  epSpent                  Int                     @default(0)
  gold                     Int                     @default(100)
  fame                     Int                     @default(0)
  attrs                    Json
  freeAttrPoints           Int                     @default(10)
  hpCurrent                Int                     @default(0)
  hpMax                    Int                     @default(0)
  mpCurrent                Int                     @default(0)
  mpMax                    Int                     @default(0)
  dungeonRegisteredId      String?
  eloRating                Int                     @default(1000)
  arenaWins                Int                     @default(0)
  arenaLosses              Int                     @default(0)
  adventureEnergy          Int                     @default(100)
  adventureEnergyMax       Int                     @default(100)
  lastEnergyRechargeAt     DateTime?
  onboardingDone           Boolean                 @default(false)
  pushToken                String?
  lastLoginAt              DateTime?
  loginStreak              Int                     @default(0)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  inventoryMaxSize         Int                     @default(20)
  bazarListings            BazarListing[]
  bazarPurchases           BazarPurchase[]
  clanMember               ClanMember?
  combatProfiles           CombatProfile[]
  dungeonRuns              DungeonRun[]
  dungeonRunParticipants   DungeonRunParticipant[]
  forumReplies             ForumReply[]
  forumTopics              ForumTopic[]
  groupInvites             GroupInvite[]
  groupMembers             GroupMember[]
  heroAchievements         HeroAchievement[]
  items                    HeroItem[]
  materials                HeroMaterial[]
  heroQuests               HeroQuest[]
  skills                   HeroSkill[]
  class                    Class                   @relation(fields: [classId], references: [id])
  race                     Race                    @relation(fields: [raceId], references: [id])
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications            Notification[]
  duelHistory1             DuelHistory[]   @relation("DuelHero1")
  duelHistory2             DuelHistory[]   @relation("DuelHero2")
  duelWins                 DuelHistory[]   @relation("DuelWinner")
  tournamentParticipations TournamentParticipant[]
  heroEventParticipations HeroEventParticipation[]
  factionReps             HeroFactionRep[]
  factionRepGrants        FactionRepGrant[]
  heroAdventures          HeroAdventure[]
  currentUser              User?                   @relation("CurrentHero")

  @@index([userId])
  @@map("heroes")
}

model HeroSkill {
  id         String   @id @default(uuid())
  heroId     String
  skillId    Int
  rank       Int      @default(1)
  unlockedAt DateTime @default(now())
  hero       Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([heroId, skillId])
  @@map("hero_skills")
}

model HeroItem {
  id           String         @id @default(uuid())
  heroId       String
  itemId       Int
  equipped     Boolean        @default(false)
  runesIn      Json           @default("[]")
  upgradeLevel Int            @default(0)
  statOverrides Json           @default("{}")
  obtainedAt   DateTime       @default(now())
  slot         EquipmentSlot?
  bazarListing BazarListing?
  hero         Hero           @relation(fields: [heroId], references: [id], onDelete: Cascade)
  item         Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("hero_items")
}

model HeroMaterial {
  heroId     String
  materialId Int
  quantity   Int      @default(0)
  hero       Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([heroId, materialId])
  @@map("hero_materials")
}

model CombatProfile {
  id              String         @id @default(uuid())
  heroId          String
  name            String         @default("Estándar")
  dungeonLevel    Int?
  position        CombatPosition @default(front)
  initiativeSkill String         @default("organization")
  prelimRules     Json           @default("[]")
  roundRules      Json           @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  defenseSkills   Json           @default("{\"magic\": null, \"melee\": null, \"ranged\": null}")
  hero            Hero           @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@unique([heroId, dungeonLevel])
  @@map("combat_profiles")
}

model DungeonRun {
  id            String     @id @default(uuid())
  heroId        String
  dungeonId     Int
  profileId     String?
  startedAt     DateTime   @default(now())
  completesAt   DateTime?
  registeredAt  DateTime   @default(now())
  executedAt    DateTime?
  status        RunStatus  @default(registered)
  result        RunResult?
  report        Json?
  levelsCleared Int        @default(0)
  epGained      Int?
  goldGained    Int?
  fameGained    Int?
  loot          Json?
  createdAt     DateTime   @default(now())
  groupId       String?
  levelReports  Json?
  dungeon       Dungeon    @relation(fields: [dungeonId], references: [id])
  group         ClanGroup? @relation(fields: [groupId], references: [id])
  hero          Hero       @relation(fields: [heroId], references: [id], onDelete: Cascade)
  participants  DungeonRunParticipant[]

  @@index([heroId, status])
  @@index([heroId, createdAt])
  @@index([dungeonId, status])
  @@index([groupId])
  @@map("dungeon_runs")
}


model DungeonRunParticipant {
  id        String     @id @default(uuid())
  runId     String
  heroId    String?
  profileId String?
  snapshot  Json
  createdAt DateTime   @default(now())
  run       DungeonRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  hero      Hero?      @relation(fields: [heroId], references: [id], onDelete: SetNull)

  @@unique([runId, heroId])
  @@index([heroId, createdAt])
  @@map("dungeon_run_participants")
}

model BazarListing {
  id          String          @id @default(uuid())
  sellerId    String
  heroItemId  String          @unique
  itemId      Int
  listingType ListingType     @default(fixed)
  price       Int
  startPrice  Int?
  buyNowPrice Int?
  expiresAt   DateTime
  status      ListingStatus   @default(active)
  cycle       Int             @default(1)
  views       Int             @default(0)
  createdAt   DateTime        @default(now())
  heroItem    HeroItem        @relation(fields: [heroItemId], references: [id], onDelete: Cascade)
  item        Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seller      Hero            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  purchases   BazarPurchase[]

  @@index([status, expiresAt])
  @@index([itemId, status])
  @@map("bazar_listings")
}

model BazarPurchase {
  id          String       @id @default(uuid())
  listingId   String
  buyerId     String
  pricePaid   Int
  cycle       Int          @default(1)
  purchasedAt DateTime     @default(now())
  buyer       Hero         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  listing     BazarListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, cycle, pricePaid])
  @@map("bazar_purchases")
}

model Clan {
  id               String                   @id @default(uuid())
  name             String                   @unique
  tag              String                   @unique
  icon             String
  description      String?
  gold             Int                      @default(0)
  fame             Int                      @default(0)
  level            Int                      @default(1)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  events           ClanEventParticipation[]
  groups           ClanGroup[]
  members          ClanMember[]
  upgrades         ClanUpgrade[]
  exclusiveDungeon Dungeon?
  forumCategories  ForumCategory[]

  @@map("clans")
}

model ClanMember {
  heroId          String     @id
  clanId          String
  role            ClanRole   @default(member)
  goldContributed Int        @default(0)
  joinedAt        DateTime   @default(now())
  groupId         String?
  groupRole       GroupRole?
  clan            Clan       @relation(fields: [clanId], references: [id], onDelete: Cascade)
  group           ClanGroup? @relation(fields: [groupId], references: [id])
  hero            Hero       @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("clan_members")
}

model ClanGroup {
  id           String        @id @default(uuid())
  clanId       String?
  name         String
  icon         String        @default("⚔️")
  leaderId     String
  createdAt    DateTime      @default(now())
  clan         Clan?         @relation(fields: [clanId], references: [id], onDelete: Cascade)
  members      ClanMember[]
  dungeonRuns  DungeonRun[]
  invites      GroupInvite[]
  groupMembers GroupMember[]

  @@unique([clanId, name])
  @@map("clan_groups")
}

model GroupMember {
  id       String    @id @default(uuid())
  groupId  String
  heroId   String
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now())
  group    ClanGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  hero     Hero      @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@unique([groupId, heroId])
  @@map("group_members")
}

model GroupInvite {
  id        String       @id @default(uuid())
  groupId   String
  heroId    String
  status    InviteStatus @default(pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  group     ClanGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  hero      Hero         @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@unique([groupId, heroId])
  @@map("group_invites")
}

model ClanUpgrade {
  id         String   @id @default(uuid())
  clanId     String
  upgradeId  String
  tier       Int      @default(1)
  unlockedAt DateTime @default(now())
  clan       Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, upgradeId])
  @@map("clan_upgrades")
}

model WeeklyEvent {
  id             String                   @id @default(uuid())
  name           String
  description    String
  type           String
  dungeonId      Int?
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean                  @default(false)
  rewards        Json
  createdAt      DateTime                 @default(now())
  participations ClanEventParticipation[]
  heroParticipations HeroEventParticipation[]

  @@index([isActive, startsAt, endsAt])
  @@map("weekly_events")
}

model ClanEventParticipation {
  clanId    String
  eventId   String
  score     Int         @default(0)
  updatedAt DateTime    @updatedAt
  claimed   Boolean     @default(false)
  clan      Clan        @relation(fields: [clanId], references: [id], onDelete: Cascade)
  event     WeeklyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([clanId, eventId])
  @@map("clan_event_participations")
}

model HeroEventParticipation {
  heroId    String
  eventId   String
  progress  Int      @default(0)
  target    Int
  completed Boolean  @default(false)
  claimedAt DateTime?
  createdAt DateTime @default(now())
  hero      Hero        @relation(fields: [heroId], references: [id], onDelete: Cascade)
  event     WeeklyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([heroId, eventId])
  @@map("hero_event_participations")
}

model Tournament {
  id           String                  @id @default(uuid())
  name         String
  startsAt     DateTime
  endsAt       DateTime
  status       TournamentStatus        @default(registration)
  minElo       Int                     @default(0)
  maxPlayers   Int                     @default(8)
  rewards      Json
  rewardsDistributedAt DateTime?
  createdAt    DateTime                @default(now())
  matches      TournamentMatch[]
  participants TournamentParticipant[]

  @@map("tournaments")
}

model TournamentParticipant {
  id           String     @id @default(uuid())
  tournamentId String
  heroId       String
  seed         Int
  eliminated   Boolean    @default(false)
  hero         Hero       @relation(fields: [heroId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, heroId])
  @@map("tournament_participants")
}

model TournamentMatch {
  id           String     @id @default(uuid())
  tournamentId String
  round        Int
  matchNumber  Int
  hero1Id      String?
  hero2Id      String?
  winnerId     String?
  log          Json?
  playedAt     DateTime?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_matches")
}

model Quest {
  id           String      @id @default(uuid())
  slug         String      @unique
  name         String
  type         QuestType
  description  String
  npcName      String
  npcDialog    String
  objectives   Json
  rewards      Json
  chainNext    String?
  levelReq     Int         @default(1)
  isRepeatable Boolean     @default(false)
  resetHours   Int?
  createdAt    DateTime    @default(now())
  heroQuests   HeroQuest[]

  @@map("quests")
}

model HeroQuest {
  id          String      @id @default(uuid())
  heroId      String
  questId     String
  status      QuestStatus @default(active)
  progress    Json        @default("{}")
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  hero        Hero        @relation(fields: [heroId], references: [id], onDelete: Cascade)
  quest       Quest       @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([heroId, questId])
  @@index([heroId, status])
  @@map("hero_quests")
}

model Achievement {
  id          String            @id @default(uuid())
  slug        String            @unique
  name        String
  description String
  icon        String
  category    String
  condition   Json
  rewards     Json
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  heroes      HeroAchievement[]

  @@map("achievements")
}

model HeroAchievement {
  id            String      @id @default(uuid())
  heroId        String
  achievementId String
  progress      Json        @default("{}")
  completed     Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  hero          Hero        @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@unique([heroId, achievementId])
  @@map("hero_achievements")
}

model ForumCategory {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  description String
  icon        String
  clanId      String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  clan        Clan?        @relation(fields: [clanId], references: [id])
  topics      ForumTopic[]

  @@map("forum_categories")
}

model ForumTopic {
  id         String        @id @default(uuid())
  categoryId String
  authorId   String
  title      String
  content    String
  isPinned   Boolean       @default(false)
  isLocked   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  replies    ForumReply[]
  author     Hero          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("forum_topics")
}

model ForumReply {
  id        String     @id @default(uuid())
  topicId   String
  authorId  String
  content   String
  createdAt DateTime   @default(now())
  author    Hero       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("forum_replies")
}

model AttributeDefinition {
  id           String   @id @default(uuid())
  name         String   @unique
  abbreviation String   @unique
  description  String?
  minValue     Int      @default(1)
  maxValue     Int      @default(100)
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("attribute_definitions")
}

model DuelHistory {
  id          String   @id @default(uuid())
  hero1Id     String
  hero2Id     String
  winnerId    String
  eloChange1  Int
  eloChange2  Int
  rounds      Int
  log         Json?
  goldCost    Int      @default(0)
  foughtAt    DateTime @default(now())
  hero1       Hero     @relation("DuelHero1", fields: [hero1Id], references: [id], onDelete: Cascade)
  hero2       Hero     @relation("DuelHero2", fields: [hero2Id], references: [id], onDelete: Cascade)
  winner      Hero     @relation("DuelWinner", fields: [winnerId], references: [id], onDelete: Cascade)

  @@index([hero1Id, foughtAt])
  @@index([hero2Id, foughtAt])
  @@map("duel_history")
}

model Notification {
  id        String    @id @default(uuid())
  heroId    String
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  hero      Hero      @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@index([heroId, readAt])
  @@map("notifications")
}

enum ClassRole {
  tank
  dps
  healer
  support
  hybrid
}

enum CombatPosition {
  front
  center
  rear
  left_flank
  right_flank
  flexible
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum SkillTiming {
  pre_round
  round
  both
  passive
}

enum SkillType {
  active
  passive
  basic
}

enum ItemCategory {
  weapon
  armor
  accessory
  consumable
  rune
  material
}

enum EquipmentSlot {
  head
  face
  neck
  shoulders
  back
  chest
  arms
  hands
  mainHand
  offHand
  belt
  legs
  feet
  backpack
}

enum ItemRarity {
  common
  uncommon
  rare
  epic
  unique
}

enum RunStatus {
  registered
  running
  done
  failed
}

enum RunResult {
  victory
  defeat
}

enum ListingType {
  fixed
  auction
}

enum ListingStatus {
  active
  sold
  expired
  cancelled
}

enum InviteStatus {
  pending
  accepted
  rejected
}

enum ClanRole {
  leader
  officer
  member
}

enum GroupRole {
  leader
  member
}

enum TournamentStatus {
  registration
  active
  completed
}

enum QuestType {
  main
  daily
  clan
  lore
}

enum QuestStatus {
  active
  completed
  failed
}

model Faction {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String
  icon        String
  color       String   @default("#6B7280")
  createdAt   DateTime @default(now())
  shops       FactionShop[]
  adventures  Adventure[]
  heroReps    HeroFactionRep[]
  repGrants   FactionRepGrant[]

  @@map("factions")
}

model FactionShop {
  id         Int      @id @default(autoincrement())
  factionId  Int
  name       String
  icon       String
  minRep     Int      @default(0)
  items      Json
  createdAt  DateTime @default(now())
  faction    Faction  @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@map("faction_shops")
}

model Adventure {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  icon          String
  description   String
  lore          String?
  levelReq      Int            @default(1)
  maxLevel      Int            @default(999)
  duration      Int            @default(30)
  energyCost    Int            @default(10)
  steps         Json
  rewards       Json
  factionId     Int?
  factionRep    Int            @default(0)
  isActive      Boolean        @default(true)
  minGoldReward Int            @default(0)
  maxGoldReward Int            @default(50)
  epReward      Int            @default(20)
  fameReward    Int            @default(2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  faction       Faction?       @relation(fields: [factionId], references: [id])
  heroAdventures HeroAdventure[]

  @@map("adventures")
}

model HeroAdventure {
  id            String         @id @default(uuid())
  heroId        String
  adventureId   Int
  status        AdventureStatus @default(active)
  currentStep   Int            @default(0)
  totalSteps    Int            @default(1)
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  energySpent   Int            @default(0)
  result        Json?
  hero          Hero           @relation(fields: [heroId], references: [id], onDelete: Cascade)
  adventure     Adventure      @relation(fields: [adventureId], references: [id])

  @@index([heroId, status])
  @@index([heroId, adventureId])
  @@map("hero_adventures")
}

enum AdventureStatus {
  active
  completed
  failed
  claimed
}

model HeroFactionRep {
  heroId    String
  factionId Int
  rep       Int      @default(0)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hero      Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  faction   Faction  @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@id([heroId, factionId])
  @@map("hero_faction_reps")
}



model FactionRepGrant {
  id         String   @id @default(cuid())
  heroId     String
  factionId  Int
  sourceType String
  sourceId   String
  createdAt  DateTime @default(now())
  hero       Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  faction    Faction  @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@unique([heroId, factionId, sourceType, sourceId])
  @@index([heroId, createdAt])
  @@map("faction_rep_grants")
}

model DungeonRunRewardGrant {
  id        String   @id @default(cuid())
  runId     String
  heroId    String
  kind      String
  createdAt DateTime @default(now())

  @@unique([runId, heroId, kind])
  @@index([heroId, createdAt])
}

# Railway proporciona DATABASE_URL automáticamente con el plugin PostgreSQL
# DATABASE_URL="postgresql://..."

# Railway proporciona REDIS_URL automáticamente con el plugin Redis
# REDIS_URL="redis://..."

# Generar con: openssl rand -base64 32
AUTH_SECRET=""

# La URL de Railway se ve así: https://ironhold-production.up.railway.app
AUTH_URL=""

# Secreto para endpoints cron
CRON_SECRET=""

# Opcional: OneSignal push notifications
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

[TEMPLATE]
# Railway proporciona DATABASE_URL automáticamente con el plugin PostgreSQL
# DATABASE_URL="postgresql://..."

# Alternativa a DATABASE_URL: configurar credenciales por separado
# DB_HOST="127.0.0.1"
# DB_PORT="5433"
# DB_USER="postgres"
# DB_PASSWORD=""
# DB_NAME="ironhold"

# Railway proporciona REDIS_URL automáticamente con el plugin Redis
# REDIS_URL="redis://..."

# Generar con: openssl rand -base64 32
AUTH_SECRET=""

# La URL de Railway se ve así: https://ironhold-production.up.railway.app
AUTH_URL=""

# Secreto para endpoints cron (usado en server-side)
CRON_SECRET=""

# Secreto para el CronPoller en development (expuesto al cliente, NO usar el mismo valor que CRON_SECRET)
NEXT_PUBLIC_CRON_POLL_SECRET=""

# Credenciales del usuario admin (se crea al hacer seed)
ADMIN_EMAIL="admin@ironhold.com"
ADMIN_PASSWORD=""

# Opcional: OneSignal push notifications
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""
